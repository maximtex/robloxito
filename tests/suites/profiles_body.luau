-- Personajes: ProfileLogic (lógica pura), SaveService (una entrada por personaje y la cuenta),
-- PlayerDataService (con quién se entra) y ProfileService (crear y elegir).
-- La cuenta se lee con GetAsync: el DataStore simulado de las demás baterías no lo tiene (y
-- allí se juega con el 1, como si la cuenta no se pudiera leer); aquí sí.
DataStoreStub.GetAsync = function(_, key)
	if storeFail > 0 then
		storeFail -= 1
		error("simulated DataStore failure")
	end
	return deep(storeData[key])
end
QuestLogic.init(QuestConfig, EnemyConfig)
PlayerDataService.start()
UpgradeService.start()
QuestService.start()
ProfileService.start()

local failures = 0
local function check(name, ok)
	if not ok then failures += 1 end
	print((ok and "OK   " or "FALLO") .. "  " .. name)
end
local styles = StyleConfig.Styles

print("-- 1. Lógica pura")
local account = ProfileLogic.empty()
check("cuenta vacía: sin personajes y se entra con el 1", ProfileLogic.count(account) == 0 and account.Last == 1)
ProfileLogic.ensureSlot(account, 1, 100)
check("el de siempre aparece como el 1, sin clase fija", account.Slots[1] ~= nil and account.Slots[1].Style == nil)
local code, slot = ProfileLogic.create(account, "Magic", 200, styles)
check("crear: hueco 2 con su clase, nuevo y el siguiente con el que entrar", code == "Success" and slot == 2 and account.Slots[2].Style == "Magic" and account.Slots[2].Fresh == true and account.Last == 2)
check("una clase que no existe no se crea", (ProfileLogic.create(account, "Nope", 0, styles)) == "InvalidRequest" and (ProfileLogic.create(account, 5, 0, styles)) == "InvalidRequest" and ProfileLogic.count(account) == 2)
ProfileLogic.create(account, "Fists", 300, styles)
check("como mucho " .. ProfileLogic.MaxProfiles, (ProfileLogic.create(account, "Warrior", 0, styles)) == "Full" and ProfileLogic.count(account) == ProfileLogic.MaxProfiles and ProfileLogic.freeSlot(account) == nil)
check("elegir uno que existe", ProfileLogic.select(account, 1) == "Success" and account.Last == 1)
check("elegir uno que no existe", ProfileLogic.select(account, 5) == "InvalidRequest" and ProfileLogic.select(account, "x") == "InvalidRequest" and account.Last == 1)
ProfileLogic.updateSummary(account, 2, 3.7, "CrystalValley")
check("resumen: renacimientos enteros, zona y deja de ser nuevo", account.Slots[2].Rebirths == 3 and account.Slots[2].Zone == "CrystalValley" and account.Slots[2].Fresh == nil)
local stored = ProfileLogic.serialize(account)
check("se guarda con claves de texto", stored.Slots["2"] ~= nil and stored.Slots[2] == nil)
local back = ProfileLogic.sanitize(stored, styles)
check("guardar y cargar da lo mismo", back.Slots[2].Style == "Magic" and back.Slots[3].Style == "Fists" and back.Slots[1].Style == nil and back.Last == 1 and ProfileLogic.count(back) == 3)
local messy = ProfileLogic.sanitize({ Slots = { ["1"] = { Style = "Nope", Rebirths = -2 }, ["4"] = { Style = "Magic" }, ["1.5"] = {}, x = 1 }, Last = 9 }, styles)
check("guardado raro: clase inexistente fuera, huecos fuera de rango fuera y Last válido", messy.Slots[1].Style == nil and messy.Slots[1].Rebirths == 0 and messy.Slots[4] == nil and ProfileLogic.count(messy) == 1 and messy.Last == 1)
check("nada guardado = cuenta vacía", ProfileLogic.count(ProfileLogic.sanitize(nil, styles)) == 0 and ProfileLogic.count(ProfileLogic.sanitize("x", styles)) == 0)
local list = ProfileLogic.decode(ProfileLogic.encode(account))
check("lista para el cliente (atributo) ida y vuelta", #list == 3 and list[1].Slot == 1 and list[1].Style == nil and list[2].Style == "Magic" and list[2].Rebirths == 3 and list[2].Zone == "CrystalValley" and list[3].Zone == nil)
check("lista vacía o rota", #ProfileLogic.decode("") == 0 and #ProfileLogic.decode(nil) == 0 and #ProfileLogic.decode("a:b|::") == 0)
local older = ProfileLogic.empty()
ProfileLogic.ensureSlot(older, 1, 0)
ProfileLogic.merge(older, ProfileLogic.sanitize(stored, styles))
check("juntar: un guardado viejo no borra personajes creados después", ProfileLogic.count(older) == 3 and older.Slots[2].Style == "Magic")

print("-- 2. Una entrada por personaje")
check("el 1 es la entrada de siempre", SaveService.keyFor(5) == "player_5" and SaveService.keyFor(5, 1) == "player_5")
check("los demás, aparte", SaveService.keyFor(5, 2) == "player_5_s2" and SaveService.keyFor(5, 3) == "player_5_s3")

print("-- 3. Jugador de antes de los personajes")
storeData.player_21 = { Version = 1, Pets = { { Uid = "1", PetId = "MossFox" } }, Equipped = { "1" }, NextPetUid = 2, Style = "Fists", Skills = { Picked = true } }
local ana = newPlayer("Ana", 21)
join(ana)
advance(0)
local profile = PlayerDataService.get(ana)
check("entra con su partida de siempre (hueco 1)", profile.DataState == "Loaded" and profile.Slot == 1 and profile.PetData.Style == "Fists")
check("sin clase fija: cambia de estilo como antes", profile.PetData.FixedStyle == nil and ana:GetAttribute("FixedStyle") == "")
local listed = ProfileLogic.decode(ana:GetAttribute("Profiles"))
check("su lista: un personaje, el que juega", #listed == 1 and listed[1].Slot == 1 and listed[1].Style == nil and ana:GetAttribute("ProfileSlot") == 1)

print("-- 4. Crear un personaje")
profile.Money = 777
fireServer("ProfileAction", ana, "Create", "Magic")
advance(1)
local result = lastResult("ProfileResult", ana)
check("se crea y se avisa", result ~= nil and result[1] == true and result[2] == "Success" and result[3] == "Create")
check("vuelve a entrar (viaje al mismo juego)", #teleports == 1 and teleports[1].Players[1] == ana)
local saved = storeData.account_21
check("cuenta guardada: dos personajes y se entra con el nuevo", saved ~= nil and saved.Slots["2"] ~= nil and saved.Slots["2"].Style == "Magic" and saved.Last == 2)
check("su partida se guardó antes de irse", storeData.player_21.Money == 777)
leave(ana)
advance(1)
check("al salir no se pisa la cuenta", storeData.account_21.Last == 2 and storeData.account_21.Slots["2"] ~= nil)

print("-- 5. Entrar con el personaje nuevo")
local ana2 = newPlayer("Ana", 21)
join(ana2)
advance(0)
local p2 = PlayerDataService.get(ana2)
check("carga el hueco 2: partida nueva", p2.DataState == "Loaded" and p2.Slot == 2 and p2.Money ~= 777)
check("con su clase puesta y fija (no se le pregunta el estilo)", p2.PetData.Style == "Magic" and p2.PetData.FixedStyle == "Magic" and p2.PetData.Skills.Picked == true and ana2:GetAttribute("FixedStyle") == "Magic" and ana2:GetAttribute("StylePicked") == true)
check("empieza con la mascota inicial", #p2.PetData.Pets == 1 and p2.PetData.Pets[1].PetId == "Sproutling")
check("la partida de siempre sigue intacta", storeData.player_21.Money == 777 and storeData.player_21.Style == "Fists")
leave(ana2)
advance(1)
check("se guarda en su propia entrada, con su clase", storeData.player_21_s2 ~= nil and storeData.player_21_s2.FixedStyle == "Magic" and storeData.player_21.FixedStyle == nil)
check("en la lista deja de ser nuevo", storeData.account_21.Slots["2"].Fresh == nil and storeData.account_21.Slots["2"].Zone ~= nil)

print("-- 6. Volver al de siempre")
local ana3 = newPlayer("Ana", 21)
join(ana3)
advance(0)
fireServer("ProfileAction", ana3, "Select", 2)
advance(1)
result = lastResult("ProfileResult", ana3)
check("el que ya juega: no hace nada", result ~= nil and result[1] == false and result[2] == "AlreadySelected" and #teleports == 1)
advance(4)
fireServer("ProfileAction", ana3, "Select", 9)
advance(1)
result = lastResult("ProfileResult", ana3)
check("uno que no existe: no", result[1] == false and result[2] == "InvalidRequest" and storeData.account_21.Last == 2)
advance(4)
fireServer("ProfileAction", ana3, "Select", 1)
advance(1)
result = lastResult("ProfileResult", ana3)
check("elegir el 1: se guarda y vuelve a entrar", result[1] == true and result[3] == "Select" and storeData.account_21.Last == 1 and #teleports == 2)
leave(ana3)
advance(1)
local ana4 = newPlayer("Ana", 21)
join(ana4)
advance(0)
local p4 = PlayerDataService.get(ana4)
check("vuelve con su partida de siempre", p4.Slot == 1 and p4.Money == 777 and p4.PetData.Style == "Fists" and p4.PetData.FixedStyle == nil)
check("y ve sus dos personajes", #ProfileLogic.decode(ana4:GetAttribute("Profiles")) == 2)
leave(ana4)
advance(1)

print("-- 7. Sin poder leer la cuenta")
storeFail = 1 -- falla la lectura de la cuenta; la partida sí carga
local bob = newPlayer("Bob", 22)
join(bob)
advance(0)
local pb = PlayerDataService.get(bob)
check("juega con el 1, como antes", pb.DataState == "Loaded" and pb.Slot == 1 and pb.Account == nil and bob:GetAttribute("Profiles") == "")
fireServer("ProfileAction", bob, "Create", "Warrior")
advance(1)
result = lastResult("ProfileResult", bob)
check("no puede crear personajes esta vez", result[1] == false and result[2] == "Unavailable" and #teleports == 2)
leave(bob)
advance(1)
check("y no se guarda ninguna cuenta (no pisa la de verdad)", storeData.account_22 == nil)

print("-- 8. Si no se puede guardar la cuenta, no se cambia")
local cid = newPlayer("Cid", 23)
join(cid)
advance(0)
storeFail = 1 -- falla el guardado de la cuenta
fireServer("ProfileAction", cid, "Create", "Warrior")
advance(1)
result = lastResult("ProfileResult", cid)
local pc = PlayerDataService.get(cid)
check("aviso y sin viaje", result[1] == false and result[2] == "Unavailable" and #teleports == 2)
check("el personaje no queda a medias", ProfileLogic.count(pc.Account) == 1 and pc.Account.Last == 1 and not pc.Switching)
leave(cid)
advance(1)

print(failures == 0 and "\nTODO OK" or ("\n" .. failures .. " FALLOS"))
